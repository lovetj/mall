/**app.wxss**/
/* ========== 全局主题变量 ========== */
page {
  --primary: #ff5000;
  --primary-light: #fff1eb;
  --text-main: #222222;
  --text-sub: #666666;
  --text-gray: #999999;
  --bg-page: #f5f6f8;
  --bg-white: #ffffff;
  --border: #eeeeee;
  --radius: 16rpx;

  background-color: var(--bg-page);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  box-sizing: border-box;
}

view,
text,
image,
scroll-view,
input,
button {
  box-sizing: border-box;
}

/* ========== 通用容器 ========== */
.page-wrap {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: var(--bg-white);
  border-radius: var(--radius);
  overflow: hidden;
}



/* ========== 通用搜索框 ========== */
.search-bar {
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  background: #f2f3f5;
  border-radius: 34rpx;
  flex: 1;
}

.search-bar .search-icon {
  font-size: 26rpx;
  color: var(--text-gray);
  margin-right: 10rpx;
}

.search-bar input {
  flex: 1;
  height: 68rpx;
  font-size: 26rpx;
  color: var(--text-main);
  background: transparent;
}

.search-bar .search-placeholder {
  color: var(--text-gray);
  font-size: 26rpx;
}

/* ========== 价格 ========== */
.price {
  color: var(--primary);
  font-weight: 600;
}

.price-symbol {
  font-size: 22rpx;
}

.price-value {
  font-size: 34rpx;
}

/* ========== 按钮 ========== */
.btn-primary {
  background: linear-gradient(90deg, #ff7a1a, #ff5000);
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-plain {
  background: var(--bg-white);
  color: var(--text-main);
  border: 1rpx solid var(--border);
  border-radius: 30rpx;
  font-size: 26rpx;
}

.btn-plain::after {
  border: none;
}

/* ========== 分区标题 ========== */
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.section-title .more {
  display: flex;
  align-items: center;
  align-self: center;
  line-height: 1;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-gray);
}

.section-title .more .more-text {
  font-size: 28rpx;
  line-height: 1;
}

.section-title .more .more-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 4rpx;
  font-size: 28rpx;
  line-height: 1;
  height: 28rpx;
}

/* ========== 商品卡片中的加购按钮 ========== */
.add-cart-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 1;
  text-align: center;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff8a3d, #ff5000);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

/* ========== 空状态 ========== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-gray);
  font-size: 26rpx;
}

.empty .empty-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

/* ========== 通用工具类 ========== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
