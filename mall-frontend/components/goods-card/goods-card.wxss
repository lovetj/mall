.goods-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.card-hover {
  opacity: 0.85;
}

.goods-img {
  width: 100%;
  height: 340rpx;
  background: #f5f6f8;
}

.goods-img image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 无图片占位：保持图片区域高度，居中展示提示 */
.goods-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f6f8;
}

.goods-img-placeholder-icon {
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 12rpx;
  opacity: 0.5;
}

.goods-img-placeholder-text {
  font-size: 24rpx;
  color: #9aa0a6;
}

.goods-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  /* 允许在 flex 行布局中收缩，防止长文本撑破卡片 */
  min-width: 0;
}

.goods-name {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #222;
  /* 最多两行，超出显示省略号（内置样式，不依赖全局类） */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-desc {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #999;
  margin-top: 8rpx;
  /* 单行显示，超出显示省略号（内置样式，不依赖全局类） */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #999;
  margin-left: 4rpx;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 自动撑到底部保证同行卡片价格对齐，padding-top 保证与描述的最小间距 */
  margin-top: auto;
  padding-top: 12rpx;
}

/* ========== list 布局 ========== */
.goods-card.is-list {
  flex-direction: row;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-card.is-list .goods-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-card.is-list .goods-info {
  padding: 0 0 0 20rpx;
  justify-content: space-between;
  /* 关键：允许 flex 子项收缩到内容宽度以下，否则长文本会把卡片撑出屏幕，ellipsis 失效 */
  min-width: 0;
  overflow: hidden;
}

.goods-card.is-list .goods-name {
  min-height: auto;
}

.goods-card.is-list .goods-desc {
  min-height: auto;
  margin-top: 6rpx;
}
