<!--商品卡片-->
<view class="goods-card {{layout === 'list' ? 'is-list' : ''}}" bindtap="onTap" hover-class="card-hover">
  <view class="goods-img">
    <image
      wx:if="{{displayImage}}"
      src="{{displayImage}}"
      mode="aspectFill"
      lazy-load
      binderror="onImageError"
    ></image>
    <!-- 无图片（接口未返回图片或加载失败）时展示占位文案 -->
    <view wx:else class="goods-img-placeholder">
      <text class="goods-img-placeholder-icon">🖼️</text>
      <text class="goods-img-placeholder-text">无图片</text>
    </view>
  </view>
  <view class="goods-info">
    <view class="goods-name ellipsis-2">{{goods.name}}</view>
    <view class="goods-desc ellipsis">{{goods.description}}</view>
    <view class="goods-bottom">
      <view class="price">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{goods.price}}</text>
        <text class="price-unit" wx:if="{{goods.unit}}">/{{goods.unit}}</text>
      </view>
      <view class="add-cart-btn" catchtap="onAddCart">+</view>
    </view>
  </view>
</view>
