<!--确认订单页：选择收货地址 + 商品清单 + 备注 + 提交-->
<view class="checkout-page">
  <!-- 可滚动内容区：高度在底部提交条顶部结束，不重叠 -->
  <scroll-view class="checkout-scroll" scroll-y="{{canScroll}}" bounces="{{false}}" enable-back-to-top>
    <view class="checkout-content">
      <!-- 收货地址 -->
      <view class="address-card" wx:if="{{address}}" bindtap="onSelectAddress">
        <view class="addr-top">
          <text class="addr-name">{{address.receiverName || address.name}}</text>
          <text class="addr-phone">{{address.phone || address.receiverPhone}}</text>
          <text class="addr-default" wx:if="{{address.isDefault === 1}}">默认</text>
        </view>
        <view class="addr-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detailAddress}}{{address.houseNumber}}</view>
        <text class="addr-arrow">›</text>
      </view>
      <view class="address-card address-empty" wx:else bindtap="onSelectAddress">
        <text class="empty-plus">＋</text>
        <text class="empty-text">请选择收货地址</text>
        <text class="addr-arrow">›</text>
      </view>

      <!-- 商品清单 -->
      <view class="section">
        <view class="section-title">商品清单 ({{totalCount}}件)</view>
        <view class="goods-item" wx:for="{{items}}" wx:key="id">
          <image class="goods-img" src="{{item.image}}" mode="aspectFill"></image>
          <view class="goods-info">
            <view class="goods-name ellipsis-2">{{item.name}}</view>
            <view class="goods-tier" wx:if="{{item.tierName}}">{{item.tierName}}</view>
            <view class="goods-price">¥{{item.price}}</view>
          </view>
          <view class="goods-count">x{{item.count}}</view>
        </view>
      </view>

      <!-- 支付方式选择 -->
      <view class="section pay-type-section">
        <view class="section-title">支付方式</view>
        <view class="pay-method-list">
          <view class="pay-method-item {{payType === 1 ? 'active' : ''}}" bindtap="onSelectPayType" data-type="{{1}}">
            <view class="pay-method-left">
              <view class="pay-icon-wrap wechat-wrap">
                <text class="pay-icon-symbol">微</text>
              </view>
              <view class="pay-method-text">
                <view class="pay-title-row">
                  <text class="pay-title">微信支付</text>
                  <text class="pay-recommend-tag">推荐</text>
                </view>
                <text class="pay-sub">微信安全快捷支付</text>
              </view>
            </view>
            <view class="pay-radio {{payType === 1 ? 'checked' : ''}}">
              <text class="radio-check" wx:if="{{payType === 1}}">✓</text>
            </view>
          </view>

          <view class="pay-method-item {{payType === 2 ? 'active' : ''}}" bindtap="onSelectPayType" data-type="{{2}}">
            <view class="pay-method-left">
              <view class="pay-icon-wrap alipay-wrap">
                <text class="pay-icon-symbol">支</text>
              </view>
              <view class="pay-method-text">
                <view class="pay-title-row">
                  <text class="pay-title">支付宝支付</text>
                </view>
                <text class="pay-sub">数亿用户的信赖选择</text>
              </view>
            </view>
            <view class="pay-radio {{payType === 2 ? 'checked' : ''}}">
              <text class="radio-check" wx:if="{{payType === 2}}">✓</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 备注 -->
      <view class="section remark-section">
        <text class="remark-label">备注</text>
        <input class="remark-input" placeholder="选填，给商家留言" value="{{remark}}" bindinput="onRemarkInput" maxlength="100" />
      </view>
    </view>
  </scroll-view>

  <!-- 底部结算：独立于滚动区，不重叠 -->
  <view class="checkout-footer">
    <view class="cost">
      <text class="cost-label">实付款：</text>
      <text class="cost-price"><text class="cost-symbol">¥</text>{{payTotal}}</text>
    </view>
    <view class="submit-btn" wx:if="{{!submitting}}" bindtap="onSubmit">提交订单</view>
    <view class="submit-btn disabled" wx:else>提交中...</view>
  </view>
</view>