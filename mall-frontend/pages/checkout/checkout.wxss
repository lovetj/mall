/* 确认订单页样式，沿用商城橙色主题 */
page {
  background: #f5f6f8;
}

.checkout-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* 可滚动内容区：占满剩余高度，结束于底部提交条之上 */
.checkout-scroll {
  flex: 1;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.checkout-content {
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding-bottom: 20rpx;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 收货地址 */
.address-card {
  position: relative;
  margin: 20rpx 20rpx 0;
  padding: 28rpx 60rpx 28rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.address-card.address-empty {
  display: flex;
  align-items: center;
  height: 120rpx;
}
.addr-top {
  display: flex;
  align-items: center;
}
.addr-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}
.addr-phone {
  font-size: 26rpx;
  color: #666;
}
.addr-default {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #ff5000;
  border: 1rpx solid #ff5000;
  border-radius: 6rpx;
  padding: 0 8rpx;
}
.addr-detail {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.addr-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #ccc;
}
.empty-plus {
  font-size: 34rpx;
  color: #ff5000;
  margin-right: 10rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #999;
}

/* 区块 */
.section {
  margin: 20rpx 20rpx 0;
  padding: 24rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 商品清单 */
.goods-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.goods-item:last-child {
  border-bottom: none;
}
.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  flex-shrink: 0;
}
.goods-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.goods-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}
.goods-tier {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
  background: #f5f6f8;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}
.goods-price {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ff5000;
}
.goods-count {
  font-size: 26rpx;
  color: #999;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 支付方式 */
.pay-type-section {
  padding-bottom: 10rpx;
}
.pay-method-list {
  display: flex;
  flex-direction: column;
}
.pay-method-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.2s ease;
}
.pay-method-item:last-child {
  border-bottom: none;
}
.pay-method-left {
  display: flex;
  align-items: center;
  flex: 1;
}
.pay-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.wechat-wrap {
  background: linear-gradient(135deg, #09bb07, #07c160);
  box-shadow: 0 4rpx 10rpx rgba(7, 193, 96, 0.2);
}
.alipay-wrap {
  background: linear-gradient(135deg, #1677ff, #0e5fd8);
  box-shadow: 0 4rpx 10rpx rgba(22, 119, 255, 0.2);
}
.pay-icon-symbol {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}
.pay-method-text {
  display: flex;
  flex-direction: column;
}
.pay-title-row {
  display: flex;
  align-items: center;
}
.pay-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.pay-recommend-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #ff5000;
  background: rgba(255, 80, 0, 0.08);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  line-height: 1.2;
}
.pay-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.pay-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
}
.pay-radio.checked {
  border-color: #ff5000;
  background: #ff5000;
}
.radio-check {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

/* 备注 */
.remark-section {
  display: flex;
  align-items: center;
}
.remark-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.remark-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 底部结算栏：正常文档流兄弟节点，不再定位悬浮，避免与内容重叠 */
.checkout-footer {
  flex-shrink: 0;
  width: 100%;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding: 0 24rpx env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}
.cost {
  display: flex;
  align-items: baseline;
}
.cost-label {
  font-size: 26rpx;
  color: #333;
}
.cost-symbol {
  font-size: 28rpx;
}
.cost-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff5000;
}
.submit-btn {
  min-width: 240rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  color: #fff;
  background: linear-gradient(90deg, #ff702a, #ff5000);
  border-radius: 42rpx;
  font-size: 30rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}
.submit-btn.disabled {
  opacity: 0.6;
}