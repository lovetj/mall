/*我的订单样式*/
.orders-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 子页签 */
.tabs {
  display: flex;
  background: #fff;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #f2f2f2;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 27rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff5000;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #ff5000;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 24rpx;
}

.order-item {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-status {
  color: #ff5000;
  font-weight: 600;
}

.order-goods-item {
  display: flex;
  padding: 20rpx 0;
}

.g-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  flex-shrink: 0;
}

.g-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.g-name {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #222;
}

.g-spec {
  margin-top: 4rpx;
}

.spec-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #ff5000;
  background: #fff2e8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid #ffbb96;
}

.g-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.g-count {
  font-size: 24rpx;
  color: #999;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 24rpx;
  color: #999;
}

.order-total {
  font-size: 24rpx;
  color: #333;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.act-btn {
  padding: 12rpx 40rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
}

.go-shop {
  margin-top: 40rpx;
  padding: 16rpx 60rpx;
  line-height: 40rpx;
}
