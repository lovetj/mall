/*我的订单样式*/
.orders-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* 子页签 */
.tabs {
  position: relative;
  display: flex;
  background: #fff;
  flex-shrink: 0;
  width: 100%;
  z-index: 10;
  border-bottom: 1rpx solid #f2f2f2;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  z-index: 2;
  transition: color 0.2s ease, font-weight 0.2s ease;
}

.tab-item.active {
  color: #ff5000;
  font-weight: 600;
}

/* 页签底部的平滑滑动指示条/滚动条 */
.tab-slider {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 20%; /* 5个tab，每个占20% */
  height: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
  z-index: 1;
}

.tab-slider::after {
  content: '';
  display: block;
  width: 52rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #ff6034, #ee0a24);
  box-shadow: 0 2rpx 8rpx rgba(238, 10, 36, 0.35);
}

/* 订单列表 */
.order-list {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx;
}

.order-item {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  transition: transform 0.1s ease;
}

.order-item:active {
  opacity: 0.96;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.head-right {
  display: flex;
  align-items: center;
}

.order-status {
  color: #ff5000;
  font-weight: 600;
}

.order-status.undelivered {
  color: #1890ff;
}

.order-status.unreceived {
  color: #fa8c16;
}

.order-status.done {
  color: #52c41a;
}

.order-status.canceled {
  color: #999;
}

.arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #ccc;
}

.order-goods-item {
  display: flex;
  padding: 20rpx 0;
}

.g-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  flex-shrink: 0;
}

.g-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.g-name {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #222;
}

.g-spec {
  margin-top: 4rpx;
}

.spec-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #ff5000;
  background: #fff2e8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid #ffbb96;
}

.g-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.g-count {
  font-size: 24rpx;
  color: #999;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 24rpx;
  color: #999;
}

.order-total {
  font-size: 24rpx;
  color: #333;
}

.order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.btn-detail {
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
  line-height: 32rpx;
  margin-right: auto;
}

.act-btn {
  padding: 12rpx 40rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
  border-radius: 32rpx;
}

.go-shop {
  margin-top: 40rpx;
  padding: 16rpx 60rpx;
  line-height: 40rpx;
  border-radius: 36rpx;
}

/* ==================== 订单详情抽屉/弹窗 ==================== */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  visibility: hidden;
  opacity: 0;
  transition: all 0.25s ease-in-out;
}

.detail-mask.show {
  visibility: visible;
  opacity: 1;
}

.detail-panel {
  background: #f8f8f8;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 85vh;
  min-height: 50vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  overflow: hidden;
}

.detail-mask.show .detail-panel {
  transform: translateY(0);
}

.detail-header {
  position: relative;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.detail-status-banner {
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff6a00 0%, #ee0a24 100%);
  color: #fff;
}

.detail-status-banner.undelivered {
  background: linear-gradient(135deg, #36cfc9 0%, #1890ff 100%);
}

.detail-status-banner.unreceived {
  background: linear-gradient(135deg, #ffc069 0%, #fa8c16 100%);
}

.detail-status-banner.done {
  background: linear-gradient(135deg, #95de64 0%, #52c41a 100%);
}

.detail-status-banner.canceled {
  background: linear-gradient(135deg, #bfbfbf 0%, #8c8c8c 100%);
}

.status-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.status-texts {
  display: flex;
  flex-direction: column;
}

.status-main {
  font-size: 34rpx;
  font-weight: bold;
}

.status-sub {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.close-btn {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
  z-index: 10;
}

.detail-body {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.detail-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 18rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.receiver-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.receiver-phone {
  margin-left: 20rpx;
  color: #666;
  font-size: 26rpx;
  font-weight: normal;
}

.receiver-addr {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #666;
  line-height: 36rpx;
}

/* 商品明细 */
.detail-goods-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #fafafa;
}

.detail-goods-item:last-child {
  border-bottom: none;
}

.dg-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #f8f8f8;
  flex-shrink: 0;
}

.dg-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dg-name {
  font-size: 26rpx;
  color: #333;
  line-height: 36rpx;
}

.dg-spec {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  margin: 6rpx 0;
}

.dg-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dg-price {
  font-size: 26rpx;
  color: #ff5000;
  font-weight: 600;
}

.dg-count {
  font-size: 24rpx;
  color: #999;
}

/* 费用明细 */
.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 14rpx;
}

.fee-row.total-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f5f5f5;
  font-weight: 600;
  color: #222;
}

.fee-val.highlight {
  color: #ff5000;
  font-size: 34rpx;
}

/* 订单元数据 */
.meta-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 36rpx;
}

.meta-label {
  color: #999;
  flex-shrink: 0;
}

.meta-val {
  color: #333;
  word-break: break-all;
}

.copy-btn {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  background: #e6f7ff;
}

/* 底部操作区 */
.detail-footer {
  background: #fff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.footer-btn {
  padding: 16rpx 40rpx;
  line-height: 40rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
  border-radius: 36rpx;
}
