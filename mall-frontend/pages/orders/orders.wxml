<!--我的订单-->
<view class="page-wrap orders-page">
  <!-- 子页签 -->
  <view class="tabs">
    <view
      class="tab-item {{currentTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSwitchTab"
    >
      {{item.name}}
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y>
    <view wx:if="{{orders.length === 0}}" class="empty">
      <text class="empty-icon">📋</text>
      <text>暂无相关订单</text>
      <view class="btn-primary go-shop" bindtap="goShopping">去逛逛</view>
    </view>

    <view class="order-item card" wx:for="{{orders}}" wx:key="id">
      <view class="order-head">
        <text class="order-no">订单号：{{item.id}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>
      <view class="order-goods">
        <view class="order-goods-item" wx:for="{{item.goods}}" wx:for-item="g" wx:key="id">
          <image class="g-img" src="{{g.image}}" mode="aspectFill" lazy-load></image>
          <view class="g-info">
            <view class="g-name ellipsis-2">{{g.name}}</view>
            <view class="g-spec" wx:if="{{g.tierName}}">
              <text class="spec-tag">{{g.tierName}}</text>
            </view>
            <view class="g-bottom">
              <text class="price"><text class="price-symbol">¥</text>{{g.price}}</text>
              <text class="g-count">x{{g.count}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="order-foot">
        <text class="order-time">{{item.createTime}}</text>
        <view class="order-total">
          共 {{item.totalCount}} 件，实付
          <text class="price"><text class="price-symbol">¥</text>{{item.totalPriceText}}</text>
        </view>
      </view>
      <view class="order-actions" wx:if="{{item.status === 'unpaid' || item.status === 'unreceived'}}">
        <view
          wx:if="{{item.status === 'unpaid'}}"
          class="btn-primary act-btn"
          data-id="{{item.id}}"
          bindtap="onPay"
        >立即付款</view>
        <view
          wx:if="{{item.status === 'unreceived'}}"
          class="btn-plain act-btn"
          data-id="{{item.id}}"
          bindtap="onConfirm"
        >确认收货</view>
      </view>
    </view>
    <view style="height: 40rpx"></view>
  </scroll-view>
</view>
