<!--我的页（需登录）-->
<view class="page-wrap mine-page">
  <!-- 用户信息 -->
  <view class="user-header">
    <image
      wx:if="{{userInfo.avatarUrl}}"
      class="avatar"
      src="{{userInfo.avatarUrl}}"
      mode="aspectFill"
      bindtap="onUpdateProfile"
    ></image>
    <view wx:else class="avatar avatar-empty" bindtap="onUpdateProfile">👤</view>
    <view class="user-detail">
      <view class="user-name">{{userInfo.nickName || '微信用户'}}</view>
      <view class="user-desc">优选商城 · 尊享会员</view>
    </view>
  </view>

  <!-- 数据概览 -->
  <view class="stats card">
    <view class="stat-item" data-key="orders" bindtap="onMenuTap">
      <text class="stat-value">{{cartCount}}</text>
      <text class="stat-label">购物车</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">优惠券</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">积分</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">收藏</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu card">
    <view
      class="menu-item"
      wx:for="{{menus}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onMenuTap"
      hover-class="menu-hover"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <view class="menu-text">
        <view class="menu-title">{{item.title}}</view>
        <view class="menu-desc">{{item.desc}}</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" bindtap="onLogout">退出登录</view>
  <view class="version">优选商城 v1.0.0</view>

  <!-- 登录拦截弹窗（自绘，蒙版可自定义） -->
  <login-modal
    id="loginModal"
    bind:confirm="onLoginModalConfirm"
    bind:cancel="onLoginModalClose"
  />
</view>
