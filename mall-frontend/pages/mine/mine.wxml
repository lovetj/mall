<!--我的页（需登录）-->
<view class="page-wrap mine-page">
  <!-- 用户信息 -->
  <view class="user-header" bindtap="onUserHeaderTap">
    <block wx:if="{{isLogin}}">
      <image
        wx:if="{{userInfo.avatarUrl}}"
        class="avatar"
        src="{{userInfo.avatarUrl}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="avatar avatar-empty">👤</view>
      <view class="user-detail">
        <view class="user-name">{{userInfo.nickName || '微信用户'}}</view>
        <view class="user-desc">优选商城 · 尊享会员</view>
      </view>
    </block>
    <block wx:else>
      <view class="avatar avatar-empty">👤</view>
      <view class="user-detail">
        <view class="user-name">未登录</view>
        <view class="user-desc">点击登录，同步购物车与订单</view>
        <view class="login-cta">立即登录</view>
      </view>
    </block>
  </view>

  <!-- 数据概览 -->
  <view class="stats card">
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">优惠券</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">积分</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">收藏</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu card">
    <view
      class="menu-item"
      wx:for="{{menus}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onMenuTap"
      hover-class="menu-hover"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <view class="menu-text">
        <view class="menu-title">{{item.title}}</view>
        <view class="menu-desc">{{item.desc}}</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录（仅登录后展示） -->
  <view class="logout-btn" wx:if="{{isLogin}}" bindtap="onLogout">退出登录</view>
  <view class="version">优选商城 v1.0.0</view>

  <!-- 登录拦截弹窗（自绘，蒙版可自定义） -->
  <login-modal
    id="loginModal"
    bind:confirm="onLoginModalConfirm"
    bind:cancel="onLoginModalClose"
  />
</view>
