/*购物车页样式*/
.cart-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* 头部固定在顶部（flex 布局，不随内容滚动，参考首页） */
.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
  flex-shrink: 0;
}

.cart-header-left {
  display: flex;
  align-items: baseline;
}

.cart-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  margin-right: 12rpx;
  line-height: 48rpx;
}

/* 可滚动内容区域 */
.cart-scroll {
  flex: 1;
  height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* 底部占位：结算栏 110rpx + 自定义 TabBar 100rpx + 安全区 */
.footer-placeholder {
  height: calc(230rpx + env(safe-area-inset-bottom));
}

/* 到底了提示（与首页一致） */
.no-more-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx 28rpx;
  box-sizing: border-box;
}

.no-more-line {
  width: 80rpx;
  height: 1rpx;
  background-color: #e6e6e6;
}

.no-more-text {
  margin: 0 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.cart-count {
  font-size: 24rpx;
  color: #888;
}

.edit-btn {
  font-size: 26rpx;
  color: #ff5000;
}

/* 空状态 */
.go-shop {
  margin-top: 40rpx;
  padding: 16rpx 60rpx;
  line-height: 40rpx;
}

/* 商品列表 */
.cart-list {
  padding: 0 24rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #ff5000;
  border-color: #ff5000;
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin: 0 20rpx;
  background: #f5f6f8;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
}

.item-name {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #222;
}

.item-tier {
  margin-top: 4rpx;
}

.tier-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #ff5000;
  background: #fff2e8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid #ffbb96;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  background: #f7f7f7;
  font-size: 30rpx;
  color: #333;
}

.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 26rpx;
}

.del-btn {
  position: absolute;
  right: 0;
  top: 0;
  height: 100%;
  width: 120rpx;
  background: #ff5000;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 16rpx 0;
}

/* ========== 失效/下架商品独立分区 ========== */
.off-shelf-section {
  padding: 0 24rpx;
  margin-top: 30rpx;
}

.off-shelf-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 4rpx;
  margin-bottom: 8rpx;
}

.off-shelf-title {
  display: flex;
  align-items: center;
}

.off-shelf-title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
}

.off-shelf-title-count {
  font-size: 24rpx;
  color: #999999;
  margin-left: 8rpx;
}

.clear-off-shelf-btn {
  font-size: 24rpx;
  color: #ff5000;
  padding: 6rpx 16rpx;
  border: 1rpx solid #ffbb96;
  border-radius: 24rpx;
  background: #fff;
}

.clear-off-shelf-btn:active {
  opacity: 0.8;
}

.off-shelf-item {
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
}

.off-shelf-badge {
  font-size: 20rpx;
  color: #999999;
  background: #e8e8e8;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.off-shelf-img-box {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 20rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.off-shelf-img {
  width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  filter: grayscale(100%);
  opacity: 0.8;
}

.off-shelf-mask {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 40%;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
}

.off-shelf-text {
  color: #8c8c8c !important;
}

.off-shelf-tier-tag {
  color: #999999 !important;
  background: #f0f0f0 !important;
  border-color: #d9d9d9 !important;
}

.off-shelf-tip {
  font-size: 22rpx;
  color: #ff4d4f;
  font-weight: 400;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.off-shelf-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.off-shelf-count {
  font-size: 24rpx;
  color: #999999;
  margin-right: 16rpx;
}

.off-shelf-del-text {
  font-size: 24rpx;
  color: #999999;
  padding: 4rpx 14rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 20rpx;
  background: #fff;
}

.off-shelf-del-text:active {
  color: #ff5000;
  border-color: #ff5000;
}

/* 底部固定结算栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  height: 110rpx;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
}

.footer-left {
  display: flex;
  align-items: center;
  padding-left: 20rpx;
}

.all-text {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.footer-right {
  display: flex;
  align-items: center;
}

.total {
  display: flex;
  align-items: baseline;
  margin-right: 20rpx;
}

.total-label {
  font-size: 26rpx;
  color: #333;
}

.checkout-btn {
  min-width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: linear-gradient(90deg, #ff7a1a, #ff5000);
  color: #fff;
  font-size: 28rpx;
  padding: 0 32rpx;
}
