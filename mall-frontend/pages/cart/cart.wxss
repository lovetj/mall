/*购物车页样式*/
.cart-page {
  /* 底部结算栏 110rpx + 自定义 TabBar 100rpx + 安全区 */
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
}

.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #666;
}

.edit-btn {
  color: #ff5000;
}

/* 空状态 */
.go-shop {
  margin-top: 40rpx;
  padding: 16rpx 60rpx;
  line-height: 40rpx;
}

/* 商品列表 */
.cart-list {
  padding: 0 24rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #ff5000;
  border-color: #ff5000;
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin: 0 20rpx;
  background: #f5f6f8;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
}

.item-name {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #222;
}

.item-tier {
  margin-top: 4rpx;
}

.tier-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #ff5000;
  background: #fff2e8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid #ffbb96;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  background: #f7f7f7;
  font-size: 30rpx;
  color: #333;
}

.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 26rpx;
}

.del-btn {
  position: absolute;
  right: 0;
  top: 0;
  height: 100%;
  width: 120rpx;
  background: #ff5000;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 16rpx 0;
}

/* 底部固定结算栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
}

.footer-left {
  display: flex;
  align-items: center;
}

.all-text {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.footer-right {
  display: flex;
  align-items: center;
}

.total {
  display: flex;
  align-items: baseline;
  margin-right: 20rpx;
}

.total-label {
  font-size: 26rpx;
  color: #333;
}

.checkout-btn {
  min-width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: linear-gradient(90deg, #ff7a1a, #ff5000);
  color: #fff;
  font-size: 28rpx;
  padding: 0 32rpx;
}
