/*首页样式*/
.index-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, #ff5000, #ff7a1a);
  flex-shrink: 0;
  z-index: 10;
}

.index-scroll {
  flex: 1;
  height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.header-title {
  display: none;
}

.header .search-bar {
  background: rgba(255, 255, 255, 0.95);
}

.header .search-placeholder-text {
  color: #999;
  font-size: 26rpx;
  flex: 1;
  margin-left: 12rpx;
}

/* 轮播图 */
.banner-wrap {
  padding: 20rpx 24rpx 0;
}


.banner-swiper {
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  transition: transform 0.18s ease, filter 0.18s ease;
}

/* 按下时：轻微缩小 + 变暗，松开后回弹 */
.banner-item.is-pressed {
  transform: scale(0.96);
  filter: brightness(0.85);
}

.banner-item image {
  width: 100%;
  height: 100%;
  display: block;
  background: #e9ecef;
}

/* 无图片时的占位样式：保持轮播区域高度，仅展示灰底与提示 */
.banner-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #e9ecef;
}

.banner-placeholder-icon {
  font-size: 60rpx;
  line-height: 1;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.banner-placeholder-text {
  font-size: 24rpx;
  color: #9aa0a6;
}

/* 可跳转提示：右上角小标签，带呼吸动画 */
.banner-link-tip {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  padding: 6rpx 18rpx;
  background: rgba(255, 80, 0, 0.9);
  color: #fff;
  font-size: 22rpx;
  border-radius: 24rpx;
  animation: banner-tip-pulse 1.6s ease-in-out infinite;
}

@keyframes banner-tip-pulse {
  0%,
  100% {
    transform: translateX(0);
    opacity: 1;
  }
  50% {
    transform: translateX(6rpx);
    opacity: 0.75;
  }
}

.banner-title {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 20rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
  max-width: 80%;
}

/* 商品分类：每行最多 5 个，超出换行 */
.cate-wrap {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 16rpx 8rpx;
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
}

/* 分类为空时的占位态 */
.cate-empty {
  height: 160rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.cate-empty-text {
  font-size: 26rpx;
  color: #999;
}

.cate-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 20rpx;
}

.cate-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f5f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  overflow: hidden;
  transition: transform 0.18s ease;
}

.cate-item:active .cate-icon {
  transform: scale(0.9);
}

.cate-icon image {
  width: 100%;
  height: 100%;
  display: block;
}

.cate-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #333;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 热销商品区域：整体包裹 + 自上而下的浅粉色渐变 */
.hot-section {
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fff7f4 0%, #fffbfa 45%, #ffffff 100%);
}

/* 热销商品副标题 */
.section-subtitle {
  padding: 0 24rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  letter-spacing: 2rpx;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 14rpx 0;
  box-sizing: border-box;
}

.hot-grid .hot-item {
  display: block;
  width: calc(50% - 20rpx);
  flex: 0 0 calc(50% - 20rpx);
  max-width: calc(50% - 20rpx);
  margin: 0 10rpx 20rpx;
  box-sizing: border-box;
}

/* 热销商品为空时的占位态 */
.goods-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.goods-empty-icon {
  font-size: 64rpx;
  line-height: 1;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.goods-empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 底部加载更多与到底了 */
.loading-more-bar,
.no-more-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx 28rpx;
  box-sizing: border-box;
}

.loading-spin {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 3rpx solid #e0e0e0;
  border-top-color: #ff5000;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #999999;
}

.no-more-line {
  width: 80rpx;
  height: 1rpx;
  background-color: #e6e6e6;
}

.no-more-text {
  margin: 0 16rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 搜索结果列表 */
.goods-list-wrap {
  padding: 12rpx 24rpx 0;
}

/* 自定义 TabBar 占位（与 custom-tab-bar 的 100rpx 对齐） */
.tabbar-placeholder {
  height: calc(110rpx + env(safe-area-inset-bottom));
}
