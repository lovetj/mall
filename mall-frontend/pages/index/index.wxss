/*首页样式*/
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, #ff5000, #ff7a1a);
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-title {
  display: none;
}

.header .search-bar {
  background: rgba(255, 255, 255, 0.95);
}

.header .search-placeholder-text {
  color: #999;
  font-size: 26rpx;
  flex: 1;
  margin-left: 12rpx;
}

/* 轮播图 */
.banner-wrap {
  padding: 20rpx 24rpx 0;
}

.banner-swiper {
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-item image {
  width: 100%;
  height: 100%;
  display: block;
  background: #e9ecef;
}

.banner-title {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 20rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
  max-width: 80%;
}

/* 热销商品网格 */
.hot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 12rpx 24rpx 0;
}

/* 搜索结果列表 */
.goods-list-wrap {
  padding: 12rpx 24rpx 0;
}

/* 自定义 TabBar 占位（与 custom-tab-bar 的 100rpx 对齐） */
.tabbar-placeholder {
  height: calc(110rpx + env(safe-area-inset-bottom));
}
