/*分类页样式*/
.category-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  /* 自定义 TabBar 占位（与 custom-tab-bar 的 100rpx 对齐） */
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.header {
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, #ff5000, #ff7a1a);
  flex-shrink: 0;
}

.header .search-bar {
  background: rgba(255, 255, 255, 0.95);
}

.clear-icon {
  color: #999;
  font-size: 24rpx;
  padding: 0 6rpx;
}

.body {
  flex: 1;
  display: flex;
  flex-direction: row;
  overflow: hidden;
}

/* 左侧类别 */
.side-bar {
  width: 190rpx;
  height: 100%;
  background: #f2f3f5;
  flex-shrink: 0;
}

.side-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 32rpx 12rpx 32rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.side-item .side-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.side-item .side-icon-img {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
  background: #fff;
}

.side-item .side-name {
  font-size: 24rpx;
  line-height: 32rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 「全部」：无图标且文字居中 */
.side-item.side-item-center {
  justify-content: center;
  padding-right: 24rpx;
}

.side-item.active {
  background: #fff;
  color: #ff5000;
  font-weight: 600;
}

.side-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 48rpx;
  background: #ff5000;
  border-radius: 0 8rpx 8rpx 0;
}

/* 右侧商品 */
.goods-area {
  flex: 1;
  height: 100%;
  background: #fff;
}

.goods-list {
  padding: 20rpx 20rpx 60rpx;
}

/* 空状态：在右侧列表区域内上下居中 */
.empty-center {
  flex: 1;
  min-height: 0;
  height: 100%;
  padding: 0;
  box-sizing: border-box;
}

.empty-center .empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
}

/* 列表商品：原生视图渲染，完全控制宽度和省略号 */
/* 卡片样式：柔和圆角 + 浅底 + 极淡描边，靠底色和留白拉出层次 */
.list-goods {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: #fafafa;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 16rpx;
  margin-bottom: 20rpx;
  width: 80%;
  max-width: 80%;
  box-sizing: border-box;
  border: 2rpx solid #f2f3f5;
}

/* 按下反馈：仅做轻微变暗，避免夸张 */
.list-goods.card-hover {
  background: #f4f5f7;
  opacity: 1;
}

.list-goods-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #fff;
  overflow: hidden;
}

/* 无图片占位：保持图片区域尺寸，居中展示提示 */
.list-goods-img-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.list-goods-img-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 10rpx;
  opacity: 0.5;
}

.list-goods-img-text {
  font-size: 22rpx;
  color: #9aa0a6;
}

.list-goods-info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.list-goods-name {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #222;
  /* 最多两行省略 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.list-goods-desc {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #999;
  margin-top: 8rpx;
  /* 单行省略 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.list-goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}

/* 底部加载更多与到底了（与首页保持一致） */
.loading-more-bar,
.no-more-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx 28rpx;
  box-sizing: border-box;
}

.no-more-bar {
  width: 80%;
  max-width: 80%;
}

.loading-spin {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 3rpx solid #e0e0e0;
  border-top-color: #ff5000;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #999999;
}

.no-more-line {
  width: 80rpx;
  height: 1rpx;
  background-color: #e6e6e6;
}

.no-more-text {
  margin: 0 16rpx;
  font-size: 24rpx;
  color: #999999;
}
