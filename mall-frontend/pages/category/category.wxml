<!--分类页-->
<view class="page-wrap category-page">
  <!-- 顶部搜索 -->
  <view class="header">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        value="{{keyword}}"
        placeholder="搜索商品"
        placeholder-class="search-placeholder"
        confirm-type="search"
        focus="{{searchFocus}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <text wx:if="{{keyword}}" class="clear-icon" bindtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- 左右分栏 -->
  <view class="body">
    <!-- 左侧类别 -->
    <scroll-view class="side-bar" scroll-y>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="side-item {{currentId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onSelectCategory"
      >
        <image
          wx:if="{{item.isImg}}"
          class="side-icon-img"
          src="{{item.icon}}"
          mode="aspectFill"
          lazy-load
        />
        <text wx:else class="side-icon">{{item.icon}}</text>
        <text class="side-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧商品 -->
    <scroll-view
      class="goods-area"
      scroll-y
      bindscrolltolower="onLoadMore"
      lower-threshold="80"
      refresher-enabled="{{true}}"
      refresher-triggered="{{refresherTriggered}}"
      refresher-default-style="black"
      bindrefresherrefresh="onRefresherRefresh"
    >
      <view class="area-title">{{currentName}}</view>
      <view wx:if="{{goodsList.length === 0}}" class="empty">
        <text class="empty-icon">📦</text>
        <text>该分类暂无商品</text>
      </view>
      <view class="goods-list">
        <view
          class="list-goods"
          wx:for="{{goodsList}}"
          wx:key="id"
          data-index="{{index}}"
          bindtap="onListItemTap"
          hover-class="card-hover"
          hover-stay-time="60"
        >
          <image class="list-goods-img" src="{{item.image}}" mode="aspectFill" lazy-load />
          <view class="list-goods-info">
            <view class="list-goods-name">{{item.name}}</view>
            <view class="list-goods-desc">{{item.description}}</view>
            <view class="list-goods-bottom">
              <view class="price">
                <text class="price-symbol">¥</text>
                <text class="price-value">{{item.price}}</text>
                <text class="price-unit" wx:if="{{item.unit}}">/{{item.unit}}</text>
              </view>
              <view class="add-cart-btn" catchtap="onListAddCart" data-index="{{index}}">+</view>
            </view>
          </view>
        </view>
      </view>
      <!-- 加载中与到底了提示（与首页一致） -->
      <view class="loading-more-bar" wx:if="{{loadingMore}}">
        <view class="loading-spin"></view>
        <text class="loading-text">加载中...</text>
      </view>
      <view class="no-more-bar" wx:elif="{{noMore && goodsList.length > 0}}">
        <view class="no-more-line"></view>
        <text class="no-more-text">到底了</text>
        <view class="no-more-line"></view>
      </view>
    </scroll-view>
  </view>

  <!-- 登录拦截弹窗（自绘，蒙版可自定义） -->
  <login-modal
    id="loginModal"
    bind:confirm="onLoginModalConfirm"
    bind:cancel="onLoginModalClose"
  />
</view>
