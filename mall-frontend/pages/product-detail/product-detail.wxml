<!--商品详情页-->
<view class="page-wrap detail-page">

  <!-- 加载中 -->
  <view class="state-box" wx:if="{{loadState === 'loading'}}">
    <view class="loading-spin"></view>
    <text class="state-text">加载中...</text>
  </view>

  <!-- 空态 / 接口异常：不降级本地假数据 -->
  <view class="state-box" wx:elif="{{loadState === 'empty'}}">
    <text class="state-icon">📦</text>
    <text class="state-text">商品不存在或已下架</text>
  </view>

  <block wx:else>
    <!-- 轮播图：图片取自接口 images 字段 -->
    <view class="swiper-wrap">
      <swiper
        class="detail-swiper"
        indicator-dots
        indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="#ffffff"
        autoplay
        circular
        interval="4000"
        duration="500"
      >
        <swiper-item wx:for="{{swiperImages}}" wx:key="*this">
          <image
            class="swiper-image"
            src="{{item}}"
            mode="aspectFill"
            data-url="{{item}}"
            bindtap="onPreviewImage"
          />
        </swiper-item>
        <swiper-item wx:if="{{swiperImages.length === 0}}">
          <view class="swiper-placeholder">
            <text class="swiper-placeholder-icon">🖼️</text>
            <text class="swiper-placeholder-text">暂无图片</text>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- 下架状态横幅提示 -->
    <view class="off-shelf-banner" wx:if="{{product.status === 0}}">
      <text class="off-shelf-banner-icon">⚠️</text>
      <text class="off-shelf-banner-text">该商品已下架，暂不支持购买</text>
    </view>

    <!-- 名称、价格、销量、标签 -->
    <view class="info-card {{product.status === 0 ? 'info-card-off-shelf' : ''}}">
      <view class="price-row">
        <view class="price">
          <text class="price-symbol">¥</text>
          <text class="price-value price-value-lg">{{priceText}}</text>
          <text class="price-unit" wx:if="{{currentUnit || product.unit}}">/{{currentUnit || product.unit}}</text>
          <text class="price-original" wx:if="{{currentOriginalPrice}}">¥{{currentOriginalPrice}}</text>
        </view>
        <view class="sales-info">
          <text class="sales-text">已售 {{salesText}}</text>
        </view>
      </view>

      <view class="goods-name">{{product.name}}</view>

      <view class="tag-list" wx:if="{{tagList.length > 0}}">
        <view
          class="tag-badge {{item.isHotselling ? 'tag-hot' : ''}}"
          wx:for="{{tagList}}"
          wx:key="id"
        >
          <image
            wx:if="{{item.image && !item.imageError}}"
            class="tag-icon"
            src="{{item.image}}"
            mode="aspectFit"
            data-index="{{index}}"
            binderror="onTagImageError"
            bindload="onTagImageLoad"
          />
          <text class="tag-name {{item.isHotselling ? 'tag-name-hot' : ''}}">{{item.name}}</text>
        </view>
      </view>

      <!-- 多规格选择卡片 -->
      <view class="tier-select-section" wx:if="{{tierList.length > 0}}">
        <view class="tier-section-title">
          <text class="title-text">规格定位</text>
          <text class="sub-text">（请选择对应规格层级）</text>
        </view>
        <view class="tier-options">
          <view
            class="tier-option-item {{item.id === selectedTierId ? 'active' : ''}}"
            wx:for="{{tierList}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onSelectTier"
          >
            <view class="tier-opt-name">{{item.name}}</view>
            <view class="tier-opt-price">¥{{item.price}}<text class="opt-unit" wx:if="{{item.unit}}">/{{item.unit}}</text></view>
          </view>
        </view>
      </view>

    </view>

    <!-- 商品描述 -->
    <view class="desc-card">
      <view class="desc-title">商品描述</view>
      <view class="desc-content">
        {{product.description || '暂无描述'}}
      </view>
    </view>

    <!-- 底部占位：避免内容被固定操作栏遮挡 -->
    <view class="bottom-placeholder"></view>

    <!-- 底部操作栏：左侧购物车 + 加入购物车 -->
    <view class="bottom-bar">
      <view class="bar-cart" bindtap="goCart">
        <text class="bar-cart-icon">🛒</text>
        <text class="bar-cart-text">购物车</text>
        <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
      </view>
      <view class="bar-actions">
        <view
          class="bar-btn btn-add {{product.status === 0 ? 'btn-disabled' : ''}}"
          bindtap="onAddCart"
        >
          {{product.status === 0 ? '商品已下架' : '加入购物车'}}
        </view>
      </view>
    </view>
  </block>

  <!-- 数量与规格选择弹窗 -->
  <view class="quantity-popup" wx:if="{{showQuantity}}">
    <view class="popup-mask" bindtap="closeQuantity"></view>
    <view class="popup-content" catchtap="noop">
      <view class="popup-header">
        <image
          wx:if="{{currentImage || swiperImages[0]}}"
          class="popup-image"
          src="{{currentImage || swiperImages[0]}}"
          mode="aspectFill"
        />
        <view wx:else class="popup-image popup-image-empty">🖼️</view>
        <view class="popup-info">
          <view class="price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{priceText}}</text>
            <text class="price-unit" wx:if="{{currentUnit || product.unit}}">/{{currentUnit || product.unit}}</text>
            <text class="price-original" wx:if="{{currentOriginalPrice}}">¥{{currentOriginalPrice}}</text>
          </view>
          <view class="popup-stock" wx:if="{{currentStock !== undefined}}">库存: {{currentStock}}件</view>
          <view class="popup-selected" wx:if="{{selectedTier}}">已选: {{selectedTier.name}}</view>
        </view>
        <view class="popup-close" bindtap="closeQuantity">✕</view>
      </view>

      <!-- 弹窗内的规格切换 -->
      <view class="popup-tier-section" wx:if="{{tierList.length > 0}}">
        <view class="popup-section-label">规格</view>
        <view class="popup-tier-list">
          <view
            class="popup-tier-chip {{item.id === selectedTierId ? 'active' : ''}}"
            wx:for="{{tierList}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onSelectTier"
          >
            <text>{{item.name}} (¥{{item.price}})</text>
          </view>
        </view>
      </view>

      <view class="quantity-row">
        <text class="quantity-label">购买数量</text>
        <view class="quantity-control">
          <view class="control-btn {{quantity <= 1 ? 'disabled' : ''}}" bindtap="onDecrease">-</view>
          <text class="control-num">{{quantity}}</text>
          <view class="control-btn" bindtap="onIncrease">+</view>
        </view>
      </view>

      <view class="popup-btn" bindtap="onConfirmQuantity">加入购物车</view>
    </view>
  </view>

  <!-- 登录拦截弹窗（自绘，蒙版可自定义） -->
  <login-modal
    id="loginModal"
    bind:confirm="onLoginModalConfirm"
    bind:cancel="onLoginModalClose"
  />
</view>
