/*商品详情页样式*/
.detail-page {
  padding-bottom: 0;
}

/* ========== 加载 / 空态 ========== */
.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
  color: var(--text-gray);
}

.state-icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.state-text {
  font-size: 28rpx;
  color: var(--text-gray);
  margin-top: 16rpx;
}

.loading-spin {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ========== 轮播图 ========== */
.swiper-wrap {
  position: relative;
  width: 100%;
  height: 750rpx;
  background: #fff;
}

.detail-swiper {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #e9ecef;
}

.swiper-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #e9ecef;
}

.swiper-placeholder-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.swiper-placeholder-text {
  font-size: 26rpx;
  color: #9aa0a6;
}

/* ========== 名称 / 价格 / 销量 / 标签 ========== */
.info-card {
  background: #fff;
  padding: 24rpx;
  margin-top: 20rpx;
  border-radius: var(--radius);
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.price {
  display: flex;
  align-items: baseline;
  color: var(--primary);
  font-weight: 600;
}

.price-value-lg {
  font-size: 48rpx;
}

.price-unit {
  font-size: 24rpx;
  color: var(--text-gray);
  font-weight: 400;
  margin-left: 6rpx;
}

.sales-info {
  display: flex;
  align-items: center;
}

.sales-text {
  font-size: 24rpx;
  color: var(--text-gray);
}

.goods-name {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--text-main);
}

/* 标签：标签名前面展示标签图片 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag-badge {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  margin: 0 16rpx 12rpx 0;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
  border-radius: 24rpx;
}

.tag-badge.tag-hot {
  background: #fff2e8;
  border-color: #ffbb96;
}

.tag-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.tag-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #389e0d;
  line-height: 1.2;
}

.tag-name.tag-name-hot {
  color: #fa541c;
  font-weight: 600;
}

/* ========== 商品描述 ========== */
.desc-card {
  background: #fff;
  padding: 24rpx;
  margin: 20rpx 24rpx 0;
  border-radius: var(--radius);
}

.desc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.desc-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-sub);
  word-break: break-all;
}

/* ========== 底部操作栏 ========== */
.bottom-placeholder {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding: 0 24rpx env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bar-cart {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  flex-shrink: 0;
}

.bar-cart-icon {
  font-size: 42rpx;
  line-height: 1;
}

.bar-cart-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-sub);
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: 8rpx;
  min-width: 32rpx;
  padding: 2rpx 10rpx;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
  border-radius: 20rpx;
}

.bar-actions {
  flex: 1;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.bar-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.btn-add {
  background: linear-gradient(135deg, #ff8a3d, #ff5000);
  border-radius: 40rpx 0 0 40rpx;
}

.btn-buy {
  background: linear-gradient(135deg, #ff5a2b, #e63c00);
  border-radius: 0 40rpx 40rpx 0;
}

.bar-btn:active {
  opacity: 0.85;
}

/* ========== 数量选择弹窗 ========== */
.quantity-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.popup-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.popup-header {
  position: relative;
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

/* 无图片时的占位（与轮播占位保持一致） */
.popup-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  opacity: 0.5;
}

.popup-info {
  flex: 1;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.popup-info .price-value {
  font-size: 40rpx;
}

.popup-close {
  position: absolute;
  top: 0;
  right: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-gray);
}

.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.quantity-label {
  font-size: 30rpx;
  color: var(--text-main);
}

.quantity-control {
  display: flex;
  align-items: center;
}

.control-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.control-btn.disabled {
  opacity: 0.4;
}

.control-num {
  width: 100rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.popup-btn {
  margin-top: 24rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(90deg, #ff7a1a, #ff5000);
  border-radius: 48rpx;
}

.popup-btn:active {
  opacity: 0.85;
}
