<!--收货地址-->
<view class="page-wrap address-page">
  <!-- 已有地址 -->
  <block wx:if="{{address}}">
    <view class="address-card card">
      <view class="addr-head">
        <text class="addr-name">{{address.name}}</text>
        <text class="addr-phone">{{address.phone}}</text>
        <text class="addr-tag">默认</text>
      </view>
      <view class="addr-detail">{{address.detail}}</view>
      <view class="addr-actions">
        <view class="btn-plain act-btn" bindtap="onAdd">编辑</view>
        <view class="btn-plain act-btn" bindtap="onDelete">删除</view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:else class="empty">
    <text class="empty-icon">📍</text>
    <text>还没有收货地址</text>
  </view>

  <!-- 新增按钮 -->
  <view class="btn-primary add-btn" wx:if="{{!showForm}}" bindtap="onAdd">+ 新增收货地址</view>

  <!-- 表单弹层 -->
  <view class="form-mask" wx:if="{{showForm}}">
    <view class="form-panel">
      <view class="form-title">{{address ? '编辑地址' : '新增地址'}}</view>
      <view class="form-row">
        <text class="form-label">收货人</text>
        <input class="form-input" value="{{form.name}}" placeholder="请输入姓名" data-field="name" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" value="{{form.phone}}" placeholder="请输入手机号" data-field="phone" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="form-label">详细地址</text>
        <input class="form-input" value="{{form.detail}}" placeholder="省市区及详细地址" data-field="detail" bindinput="onInput" />
      </view>
      <view class="form-btns">
        <view class="btn-plain form-btn" bindtap="onCancelForm">取消</view>
        <view class="btn-primary form-btn" bindtap="onSave">保存</view>
      </view>
    </view>
  </view>
</view>
