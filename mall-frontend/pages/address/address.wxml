<!-- 收货地址管理 -->
<view class="page-wrap address-page">
  <!-- 地址列表 -->
  <block wx:if="{{addressList && addressList.length > 0}}">
    <view class="address-list">
      <view class="address-card card" wx:for="{{addressList}}" wx:key="id" bindtap="onSelectAddress" data-id="{{item.id}}">
        <!-- 头部：姓名、电话、标签 -->
        <view class="addr-head">
          <text class="addr-name">{{item.receiverName}}</text>
          <text class="addr-phone">{{item.receiverPhone}}</text>
          <text class="addr-tag tag-default" wx:if="{{item.isDefault === 1}}">默认</text>
          <text class="addr-tag tag-type" wx:if="{{item.addressType}}">{{item.addressType}}</text>
        </view>

        <!-- 详细地址 -->
        <view class="addr-detail">
          <text class="addr-region">{{item.province}} {{item.city}} {{item.district}} </text>
          <text class="addr-text">{{item.detailAddress}}</text>
          <text class="addr-house" wx:if="{{item.houseNumber}}"> {{item.houseNumber}}</text>
        </view>

        <!-- 定位经纬度提示 -->
        <view class="addr-location-badge" wx:if="{{item.latitude && item.longitude}}">
          <text class="loc-icon">📍</text>
          <text class="loc-text">已关联精确地图定位</text>
        </view>

        <!-- 底部操作栏 -->
        <view class="addr-actions" catchtap="true">
          <view class="default-check {{item.isDefault === 1 ? 'is-active' : ''}}" bindtap="onSetDefault" data-id="{{item.id}}">
            <text class="check-icon">{{item.isDefault === 1 ? '✓' : '○'}}</text>
            <text class="check-label">{{item.isDefault === 1 ? '默认地址' : '设为默认'}}</text>
          </view>
          <view class="btn-group">
            <view class="act-btn" bindtap="onEdit" data-id="{{item.id}}">编辑</view>
            <view class="act-btn act-delete" bindtap="onDelete" data-id="{{item.id}}">删除</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:elif="{{!loading}}" class="empty">
    <text class="empty-icon">📍</text>
    <text class="empty-text">还没有收货地址</text>
    <text class="empty-sub">添加地址后即可快速下单</text>
  </view>

  <!-- 底部悬浮按钮栏 -->
  <view class="bottom-bar" wx:if="{{!showForm}}">
    <view class="action-row">
      <view class="btn-plain quick-btn" bindtap="onImportWxAddress">
        <text class="btn-icon">💬</text> 微信导入
      </view>
      <view class="btn-primary main-add-btn" bindtap="onAdd">
        <text class="btn-icon">➕</text> 新增收货地址
      </view>
    </view>
  </view>

  <!-- 表单弹层 / 编辑新增抽屉 -->
  <view class="form-mask" wx:if="{{showForm}}" catchtouchmove="true">
    <view class="form-panel">
      <!-- 弹层头部 -->
      <view class="form-header">
        <text class="form-title">{{form.id ? '编辑收货地址' : '新增收货地址'}}</text>
        <view class="form-close" bindtap="onCancelForm">✕</view>
      </view>

      <scroll-view scroll-y="true" class="form-body">
        <!-- 微信地图定位快捷入口 -->
        <view class="location-banner" bindtap="onChooseLocation">
          <view class="loc-left">
            <text class="loc-badge-icon">📍</text>
            <view class="loc-info">
              <text class="loc-title">{{form.latitude ? '已选择地图定位点' : '微信地图选点 / 实时定位'}}</text>
              <text class="loc-desc">{{form.detailAddress || '点击自动获取当前位置并在地图上选点'}}</text>
            </view>
          </view>
          <view class="loc-btn">选点定位 ›</view>
        </view>

        <!-- 地图定位展示组件 (当已有经纬度时展示) -->
        <view class="map-preview-wrap" wx:if="{{form.latitude && form.longitude}}">
          <map
            class="map-preview"
            latitude="{{form.latitude}}"
            longitude="{{form.longitude}}"
            markers="{{mapMarkers}}"
            scale="16"
            enable-zoom="false"
            enable-scroll="false"
          ></map>
        </view>

        <!-- 表单内容 -->
        <view class="form-group">
          <!-- 收货人 -->
          <view class="form-row">
            <text class="form-label">收货人</text>
            <input
              class="form-input"
              value="{{form.receiverName}}"
              placeholder="请填写收货人姓名"
              data-field="receiverName"
              bindinput="onInput"
            />
          </view>

          <!-- 手机号 -->
          <view class="form-row">
            <text class="form-label">手机号码</text>
            <input
              class="form-input"
              type="number"
              maxlength="11"
              value="{{form.receiverPhone}}"
              placeholder="请填写11位手机号码"
              data-field="receiverPhone"
              bindinput="onInput"
            />
          </view>

          <!-- 所在地区 (省市区) -->
          <view class="form-row">
            <text class="form-label">所在地区</text>
            <picker mode="region" value="{{form.region}}" bindchange="onRegionChange" class="form-picker">
              <view class="picker-value {{form.province ? '' : 'placeholder'}}">
                {{form.province ? form.province + ' ' + form.city + ' ' + form.district : '请选择省市区'}}
              </view>
            </picker>
          </view>

          <!-- 详细地址 -->
          <view class="form-row">
            <text class="form-label">详细地址</text>
            <input
              class="form-input"
              value="{{form.detailAddress}}"
              placeholder="街道、小区、楼栋等位置"
              data-field="detailAddress"
              bindinput="onInput"
            />
          </view>

          <!-- 门牌号 -->
          <view class="form-row">
            <text class="form-label">门牌号</text>
            <input
              class="form-input"
              value="{{form.houseNumber}}"
              placeholder="例：5号楼2单元801室"
              data-field="houseNumber"
              bindinput="onInput"
            />
          </view>

          <!-- 地址标签 -->
          <view class="form-row tag-row">
            <text class="form-label">地址标签</text>
            <view class="tag-group">
              <view
                class="tag-item {{form.addressType === item ? 'tag-item-active' : ''}}"
                wx:for="{{typeOptions}}"
                wx:key="*this"
                data-tag="{{item}}"
                bindtap="onSelectTag"
              >
                {{item}}
              </view>
            </view>
          </view>

          <!-- 设为默认地址 -->
          <view class="form-row switch-row">
            <text class="form-label">设为默认地址</text>
            <switch
              color="#ff5000"
              checked="{{form.isDefault === 1}}"
              bindchange="onSwitchDefault"
            />
          </view>
        </view>
      </scroll-view>

      <!-- 弹层底部操作 -->
      <view class="form-footer">
        <view class="btn-plain form-cancel-btn" bindtap="onCancelForm">取消</view>
        <view class="btn-primary form-save-btn" bindtap="onSave">保存地址</view>
      </view>
    </view>
  </view>
</view>
