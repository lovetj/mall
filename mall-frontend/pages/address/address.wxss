/*收货地址样式*/
.address-page {
  padding: 24rpx;
}

.address-card {
  padding: 30rpx 24rpx;
}

.addr-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.addr-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-right: 20rpx;
}

.addr-phone {
  font-size: 26rpx;
  color: #666;
}

.addr-tag {
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #ff5000;
  border: 1rpx solid #ff5000;
  border-radius: 6rpx;
}

.addr-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 38rpx;
}

.addr-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f5f5f5;
}

.act-btn {
  padding: 10rpx 36rpx;
  line-height: 40rpx;
  font-size: 25rpx;
  margin-left: 20rpx;
}

.add-btn {
  margin: 40rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

/* 表单弹层 */
.form-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.form-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}

.form-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-row {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.form-btns {
  display: flex;
  margin-top: 40rpx;
}

.form-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  margin: 0 10rpx;
}
