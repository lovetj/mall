/* 收货地址页面样式 */
.address-page {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f7f8fa;
}

/* 地址列表 */
.address-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.address-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 头部 */
.addr-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}

.addr-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 18rpx;
}

.addr-phone {
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
}

.addr-tag {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.tag-default {
  color: #ff5000;
  background: rgba(255, 80, 0, 0.1);
  border: 1rpx solid rgba(255, 80, 0, 0.3);
  font-weight: 500;
}

.tag-type {
  color: #2979ff;
  background: rgba(41, 121, 255, 0.08);
  border: 1rpx solid rgba(41, 121, 255, 0.2);
}

/* 详细地址 */
.addr-detail {
  font-size: 27rpx;
  color: #333;
  line-height: 40rpx;
  margin-bottom: 12rpx;
  word-break: break-all;
}

.addr-region {
  color: #666;
  margin-right: 6rpx;
}

.addr-house {
  color: #ff5000;
  font-weight: 500;
}

/* 定位提示徽章 */
.addr-location-badge {
  display: inline-flex;
  align-items: center;
  background: #f0f7ff;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin-bottom: 16rpx;
}

.loc-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.loc-text {
  font-size: 22rpx;
  color: #2979ff;
}

/* 底部操作区 */
.addr-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f5;
}

.default-check {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.default-check.is-active {
  color: #ff5000;
  font-weight: 500;
}

.check-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.btn-group {
  display: flex;
  align-items: center;
}

.act-btn {
  font-size: 25rpx;
  color: #666;
  padding: 8rpx 20rpx;
  margin-left: 16rpx;
  background: #f7f8fa;
  border-radius: 24rpx;
}

.act-delete {
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
}

/* 底部固定操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 50;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.quick-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 42rpx;
  border: 1rpx solid #e0e0e0;
  color: #333;
}

.main-add-btn {
  flex: 1.5;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 42rpx;
}

.btn-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

/* 表单弹层面板 */
.form-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.form-panel {
  width: 100%;
  max-height: 92vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  /* 兜底: 防止任何子元素溢出时盖到头部/底部按钮上 */
  overflow: hidden;
}

.form-header {
  position: relative;
  padding: 32rpx 36rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #f2f3f5;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.form-close {
  position: absolute;
  right: 36rpx;
  top: 28rpx;
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.form-body {
  /* flex:1 分配 panel 剩余高度(header/footer 固定), min-height:0 允许收缩并内部滚动,
     不再用固定 max-height 估算, 避免盒子过高导致内容溢出盖住底部按钮 */
  flex: 1;
  min-height: 0;
  padding: 24rpx 36rpx;
  box-sizing: border-box;
}

/* 定位横幅快捷入口 */
.location-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #e8f3ff 0%, #f0f7ff 100%);
  border: 1rpx solid #bfe0ff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.loc-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.loc-badge-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.loc-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.loc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1976d2;
  margin-bottom: 4rpx;
}

.loc-desc {
  font-size: 22rpx;
  color: #5b8db8;
  max-width: 420rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.loc-btn {
  font-size: 24rpx;
  color: #1976d2;
  font-weight: 500;
  padding: 6rpx 14rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

/* 地图微览组件 */
.map-preview-wrap {
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid #e5e9f0;
}

.map-preview {
  width: 100%;
  height: 100%;
}

/* 表单行 */
.form-group {
  display: flex;
  flex-direction: column;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f4f5f7;
  padding: 8rpx 0;
}

.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #222;
}

.form-picker {
  flex: 1;
}

.picker-value {
  font-size: 28rpx;
  color: #222;
}

.picker-value.placeholder {
  color: #999;
}

/* 标签行 */
.tag-row {
  align-items: center;
}

.tag-group {
  display: flex;
  gap: 16rpx;
}

.tag-item {
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #f2f3f5;
  border-radius: 28rpx;
  border: 1rpx solid transparent;
}

.tag-item-active {
  color: #ff5000;
  background: rgba(255, 80, 0, 0.08);
  border-color: #ff5000;
  font-weight: 500;
}

/* 默认地址切换行 */
.switch-row {
  justify-content: space-between;
  border-bottom: none;
  margin-top: 10rpx;
}

/* 弹层底部按钮 */
.form-footer {
  display: flex;
  padding: 20rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f2f3f5;
  gap: 20rpx;
}

.form-cancel-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 42rpx;
}

.form-save-btn {
  flex: 1.5;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 42rpx;
}
